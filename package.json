{
  "name": "marketscape-tw-v2",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5303 --strictPort",
    "build": "vite build",
    "build:static": "vite build --mode static",
    "snapshot": "node scripts/snapshot.mjs",
    "start": "node scripts/start.mjs",
    "server": "node --experimental-sqlite --no-warnings=ExperimentalWarning server/index.mjs",
    "stop": "node scripts/stop.mjs",
    "test": "node --experimental-sqlite --no-warnings=ExperimentalWarning --test tests/data.test.js tests/v21.test.js",
    "verify": "node scripts/verify.mjs"
  },
  "dependencies": { "three": "0.180.0" },
  "devDependencies": { "vite": "^7.0.0", "playwright-core": "^1.55.0" }
}
